import random

x = random.randint(1, 10)
y = random.randint(1, 10)
t = random.randint(1, 4)

if t == 1:       # 1 = +
    p = x + y
    q = float(input("%d+%d=" % (x, y)))  
elif t == 2:     # 2 = -
    p = x - y
    q = float(input("%d-%d=" % (x, y)))
elif t == 3:     # 3 = *
    p = x * y
    q = float(input("%dx%d=" % (x, y)))
else:            # 4 = /
    p = x / y
    q = float(input("%d/%d=" % (x, y)))

if q == p:
    print("맞았습니다.")
else:
    print("틀렸습니다.")
